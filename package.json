{
  "name": "cheffolio",
  "private": true,
  "packageManager": "bun@1.3.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter web",
    "build": "turbo run build --filter web",
    "start": "bun run --filter web start",
    "next": "bun run --filter web next",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "bun run --filter web format",
    "format:check": "bun run --filter web format:check",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "capture": "bun run --filter web capture",
    "capture:sync": "bun run --filter web capture:sync",
    "render:resume": "bun run --filter web render:resume",
    "upgrade:next": "bun run --filter web upgrade:next",
    "upgrade:tailwind": "bun run --filter web upgrade:tailwind",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.2",
    "@commitlint/config-conventional": "^20.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.2"
  },
  "dependencies": {
    "pdfjs-dist": "^6.3.289"
  }
}
