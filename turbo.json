{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "outputs": [".next/**", "!.next/cache/**", "public/resume.pdf"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "next": {
      "cache": false,
      "persistent": true
    },
    "format": {},
    "format:check": {},
    "lint": {},
    "lint:fix": {
      "cache": false
    },
    "test": {
      "cache": false
    },
    "typecheck": {}
  }
}
